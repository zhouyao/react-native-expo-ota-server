{
  "name": "react-native-expo-ota-server",
  "version": "1.0.0",
  "description": "Self-hosted Expo Updates v1 server for React Native apps on iOS and Android",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouyao/react-native-expo-ota-server.git"
  },
  "homepage": "https://github.com/zhouyao/react-native-expo-ota-server#readme",
  "bugs": {
    "url": "https://github.com/zhouyao/react-native-expo-ota-server/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "expo",
    "expo-updates",
    "ota",
    "react-native",
    "self-hosted",
    "bsdiff",
    "code-signing"
  ],
  "type": "module",
  "scripts": {
    "ota:start": "node services/ota/src/server.mjs",
    "ota:publish": "node scripts/publish.mjs",
    "ota:hotfix": "node scripts/hotfix.mjs",
    "ota:verify": "node scripts/verify-manifest.mjs",
    "ota:preflight": "node scripts/preflight.mjs",
    "ota:rollout": "node scripts/rollout.mjs",
    "ota:rollback": "node scripts/rollback.mjs",
    "ota:keygen": "node scripts/keygen.mjs",
    "ota:embedded": "node scripts/register-embedded.mjs",
    "ota:patch:rebuild": "node scripts/patches.mjs rebuild",
    "ota:patch:verify": "node scripts/patches.mjs verify",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:export": "npm --prefix apps/mobile run export",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:ios:dev": "node scripts/dev-ios.mjs",
    "mobile:android:dev": "node scripts/dev-android.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
