# Reference only: this project does not load .env automatically.
# Pass these variables through your shell, CI, or process manager.

# OTA service
PORT=3000
OTA_ENV=development
OTA_PUBLIC_BASE_URL=http://localhost:3000
# Relative paths are resolved from services/ota/.
OTA_DATA_DIR=updates
OTA_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
OTA_KEY_ID=main
OTA_ADMIN_TOKEN=
OTA_ADMIN_TOKENS=
OTA_OPERATOR=cli
OTA_EVENTS_RATE_LIMIT=60
OTA_HEALTH_URL=http://localhost:3000/healthz
OTA_CODE_SIGNING_CERT=apps/mobile/certs/certificate.pem

# Optional direct TLS termination
OTA_TLS_KEY=
OTA_TLS_CERT=

# Expo client build
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CHANNEL=development
EXPO_PUBLIC_OTA_URL=http://localhost:3000/api/manifest
EXPO_PUBLIC_ENABLE_CHANNEL_SWITCH=true
EXPO_APPLE_TEAM_ID=
