# Reference only: this project does not load .env automatically.
# Pass these variables through your shell, CI, or process manager.

# OTA service
PORT=3000
OTA_ENV=development
OTA_PUBLIC_BASE_URL=http://localhost:3000
# Relative paths are resolved from services/ota/.
OTA_DATA_DIR=updates
OTA_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
OTA_KEY_ID=main
OTA_ADMIN_TOKEN=
# label:token or label:token:scopes (scopes: release+rollout+stop-loss+gc, omit = all)
# e.g. oncall:tok-c:stop-loss can halt/restore but cannot publish
OTA_ADMIN_TOKENS=
OTA_OPERATOR=cli
OTA_EVENTS_RATE_LIMIT=60
OTA_HEALTH_URL=http://localhost:3000/healthz
OTA_CODE_SIGNING_CERT=apps/mobile/certs/certificate.pem

# Crash-aware stop-loss (opt-in). mode=monitor only alerts; halt auto-zeroes rollout.
# MIN_SAMPLES / WEBHOOK can be overridden at runtime from the dashboard "设置" tab
# (written to $OTA_DATA_DIR/system/stop-loss.json; takes precedence over these values).
OTA_STOP_LOSS_ENABLED=false
OTA_STOP_LOSS_MODE=monitor
OTA_STOP_LOSS_MIN_SAMPLES=20
OTA_STOP_LOSS_EMERGENCY_RATE=0.08
OTA_STOP_LOSS_INSTALL_FAIL_RATE=0.15
OTA_STOP_LOSS_WINDOW_MS=1800000
OTA_STOP_LOSS_COOLDOWN_MS=3600000
OTA_STOP_LOSS_ALERT_COOLDOWN_MS=900000
OTA_STOP_LOSS_CACHE_MS=300000
OTA_STOP_LOSS_WEBHOOK=

# Incremental diff updates (A-IM / bsdiff, generated at publish time)
OTA_PATCH_ENABLED=1
OTA_PATCH_MIN_SAVING=0.1
OTA_PATCH_MAX_BASES=5
OTA_BSDIFF_BIN=bsdiff
OTA_BSPATCH_BIN=bspatch
OTA_REGISTER_EMBEDDED=1

# Storage garbage collection (opt-in). mode=dry-run only logs the plan.
# Protected versions: channel current/previous, keep-last, keep-days, recent patch bases.
# Manual run: npm run ota:gc -- --rv 1 --apply
OTA_GC_ENABLED=false
OTA_GC_MODE=dry-run
OTA_GC_INTERVAL_MS=21600000
OTA_GC_INITIAL_DELAY_MS=300000
OTA_GC_KEEP_DAYS=14
OTA_GC_KEEP_LAST=10

# Optional direct TLS termination
OTA_TLS_KEY=
OTA_TLS_CERT=

# Expo client build
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CHANNEL=development
EXPO_PUBLIC_OTA_URL=http://localhost:3000/api/manifest
EXPO_PUBLIC_ENABLE_CHANNEL_SWITCH=true
EXPO_APPLE_TEAM_ID=
